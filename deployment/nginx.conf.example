# Template only. Adjust paths/upstream and validate with nginx -t.
# This server preserves /api: /api/analyze -> upstream /api/analyze.
# Place this server block inside nginx's http context.
server {
    listen 8080;
    server_name _;
    root /srv/qinan/dist;
    index index.html;
    client_max_body_size 110m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_vary on;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
        proxy_cache off;
        # Deliver optional SSE events as they arrive, including heartbeat comments.
        proxy_buffering off;
        gzip off;
        add_header Cache-Control "no-store" always;
    }

    # Vite emits hashed filenames here. Keep prior hashes during rolling deploys.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
